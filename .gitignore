# ==========================================
# 3. Environment Variables & Secrets
# ==========================================
# Ignore all .env files and local configuration overrides
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Safely un-ignore example/template env files
!.env.example
!**/.env.example
!*.env.example
!**/*.env.example

# Certificates & Private Keys
*.pem
*.key
*.crt
*.pfx
*.p12

