# Server Configuration
PORT=5000
NODE_ENV="production" # "development" or "production"
CLIENT_URL="https://your-frontend-domain.com"
API_BASE_URL="http://localhost:5000"

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://botblogs_user:secure_password@localhost:5432/botblogs?schema=public&sslmode=prefer"

# Cloudinary Media Storage (Optional if using local storage fallback)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Firebase Admin SDK Credentials (JSON formatted single-line string for production)
# Example: '{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id"}'
